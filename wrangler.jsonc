// Cloudflare Workers config: static site from dist/ + a small Worker for /api/*.
// Deploy with:  npm run deploy   (GitHub Actions does this on every push to main)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitchen-calendar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Phone → tablet inbox: one SQLite-backed Durable Object per household (works on the free plan)
  "durable_objects": {
    "bindings": [{ "name": "HOUSEHOLD", "class_name": "Household" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Household"] }]
}
